
{
  "realm": "LivingVoices",
  "enabled": true,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "learner"
      },
      {
        "name": "committee"
      }
    ]
  },
  "users": [
    {
      "username": "learner1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Learner",
      "email": "learner1@example.org",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": ["learner"]
    },
    {
      "username": "committee1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Committee",
      "email": "committee1@example.org",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": ["committee"]
    }
  ],
  "clients": [
    {
      "clientId": "edge-service",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "living-voices-dev-edge-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:9000/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "http://localhost:9000"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:9000/*"
      },
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "living-voices-test",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ]
}
